// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bundle {
  id              String       @id @default(cuid())
  shop            String
  title           String
  description     String?
  type            String // FIXED | MIX_MATCH
  status          String       @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  pricingType     String       @default("PERCENT_OFF") // FIXED_PRICE | PERCENT_OFF | AMOUNT_OFF
  pricingValue    Float        @default(0)
  // FIXED bundles: the Shopify parent product we create for the bundle
  shopifyProductId String?
  // Storefront "what's inside" widget appearance (FIXED bundles only)
  widgetStyle     String       @default("numbered") // numbered | grid | minimal
  widgetHeading   String       @default("What's inside")
  // SLOT_BUILDER only: a line of supporting copy under the widget's progress
  // line ("Choose 2 more products"). Empty = nothing rendered. Per-locale
  // versions live in `translations` under the reserved "description" key,
  // exactly as `widgetHeading` does.
  widgetDescription String     @default("")
  // SLOT_BUILDER only: the price line inside each package tab, written as a
  // template over {per_item_price} / {per_item_compare_at_price} /
  // {package_price} / {package_compare_at_price} (see PACK_PRICE_PLACEHOLDERS).
  // Empty = the widget's own default template. Per-locale versions live in
  // `translations` under the reserved "packPrice" key.
  packPriceTemplate String     @default("")
  // SLOT_BUILDER only: the per-item line under the widget's price, same
  // shortcodes as `packPriceTemplate`. Empty = the line isn't rendered at all,
  // which is why this one defaults to real copy rather than "": it's the
  // sentence the widget used to hard-code, so an upgraded shop keeps saying
  // what it said before. Per-locale versions live in `translations` under the
  // "pricePerUnit" key, alongside the rest of the widget's copy.
  pricePerUnitTemplate String  @default("That's only {per_item_price} per item.")
  accentColor     String       @default("#1a1a1a")
  showPrices      Boolean      @default(false)
  // SLOT_BUILDER only: skip the cart entirely and send the customer straight
  // to checkout after adding — the widget renders its own button instead of
  // deferring to the theme's native add-to-cart form when this is on.
  skipCart        Boolean      @default(false)
  // SLOT_BUILDER only: whether every package chooses from one shared product
  // pool (GLOBAL) or each defines its own (PER_PACKAGE). Authoring-only —
  // GLOBAL copies the same pool onto every package row on save, so the proxy,
  // the display metafield and the Cart Transform all keep reading per-package
  // pools and never need to know which mode produced them.
  poolMode        String       @default("PER_PACKAGE") // GLOBAL | PER_PACKAGE
  // SLOT_BUILDER only: don't wait for the customer to press that button —
  // the moment the last slot is filled, add to cart and go to checkout as if
  // they had. Meaningless without skipCart (there'd be no button of ours to
  // press), so the editor disables it and the publish step forces it false.
  autoCheckout    Boolean      @default(false)
  // SLOT_BUILDER only: lift the free-gift cards above the progress line —
  // i.e. above the whole builder, not just the slot rows — for a bundle whose
  // gifts are the reason to buy. Off, they sit under the slots.
  giftsBeforeSlots Boolean     @default(false)
  // Plain text + {{sku}}/{{vendor}}/{{type}}/{{barcode}}/{{weight}}/{{metafield:ns.key}}
  // placeholders, resolved per-item and rendered under each product's title
  itemSubtextTemplate String   @default("")
  showSubtextOnGifts  Boolean  @default(true)
  // FIXED bundles: waives shipping at checkout when this bundle is bought
  freeShipping    Boolean      @default(false)
  // QUANTITY_BREAKS only: which regular products the pack-size tiers apply
  // to — ALL (every product), PRODUCTS (the explicit `items` below), or
  // COLLECTIONS (every product in `rule.collectionIds`)
  quantityBreakScope String    @default("PRODUCTS")
  // SLOT_BUILDER only: storefront widget copy per storefront locale —
  // JSON { "fr": { "addItems": "Ajouter", ... }, ... } keyed by the string
  // keys in app/utils/slot-builder-text.ts. Only keys the merchant actually
  // filled in are stored; anything missing falls back to the shop's primary
  // locale and then to the widget's built-in English default. `widgetHeading`
  // above stays the primary-locale copy; its per-locale versions live here
  // under the reserved "heading" key.
  translations    String       @default("{}")
  items           BundleItem[]
  packages        BundlePackage[]
  // QUANTITY_BREAKS only; see BundleTier below
  tiers           BundleTier[]
  rule            BundleRule?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([shop, status])
}

// For QUANTITY_BREAKS bundles with quantityBreakScope = PRODUCTS, each row is
// one of the (possibly many) regular products the tiers apply to (variantId
// always null — tiers apply across all of a product's variants).
// quantity/isGift/position are unused for that type.
model BundleItem {
  id               String  @id @default(cuid())
  bundleId         String
  bundle           Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId        String // Shopify product GID
  variantId        String? // Shopify variant GID (null = any variant)
  productTitle     String
  productImageUrl  String?
  quantity         Int     @default(1)
  isGift           Boolean @default(false)
  position         Int     @default(0)
}

// QUANTITY_BREAKS bundles only: one selectable pack size ("1 pack", "2 pack",
// "4 pack", ...) with its own per-unit pricing. Applies to whichever product
// variant the shopper has selected on the storefront widget.
model BundleTier {
  id           String  @id @default(cuid())
  bundleId     String
  bundle       Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  quantity     Int
  label        String
  badgeText    String?
  badgeTone    String?
  pricingType  String  @default("PERCENT_OFF") // FIXED_PRICE | PERCENT_OFF | AMOUNT_OFF — per unit
  pricingValue Float   @default(0)
  isDefault    Boolean @default(false)
  position     Int     @default(0)
  items        BundleTierItem[]
}

// A free gift bundled with a specific pack size — always $0 at checkout,
// never the tier's own priced product (that's Bundle.items[0]).
model BundleTierItem {
  id              String     @id @default(cuid())
  tierId          String
  tier            BundleTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  productId       String // Shopify product GID
  variantId       String? // Shopify variant GID (null = any variant)
  productTitle    String
  productImageUrl String?
  quantity        Int     @default(1)
  position        Int     @default(0)
}

// FIXED bundles only: alternate purchase options under one bundle listing
// (e.g. "2 Pack", "3 Pack", "5 Pack"), each with its own item list, gifts,
// pricing, and free shipping — published as one Shopify product with one
// variant per package. A bundle with exactly one package behaves exactly
// like the original single-config FIXED bundle.
model BundlePackage {
  id               String              @id @default(cuid())
  bundleId         String
  bundle           Bundle              @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  label            String // e.g. "2 Pack"
  badgeText        String?
  badgeTone        String? // info | success | attention | warning | critical | new
  position         Int                 @default(0)
  pricingType      String              @default("PERCENT_OFF") // FIXED_PRICE | PERCENT_OFF | AMOUNT_OFF
  pricingValue     Float               @default(0)
  // Optional merchant override for the strikethrough price. NULL keeps the
  // computed default: components summed for FIXED, pool average x slot
  // count for SLOT_BUILDER. Whichever wins is written to the package's
  // Shopify variant compareAtPrice, so Shopify converts it for every
  // market exactly as it does the package price — storing a number of our
  // own and formatting it client-side would ignore currency conversion.
  compareAtPrice   Float?
  freeShipping     Boolean             @default(false)
  // SLOT_BUILDER only: the package the storefront widget opens on. No package
  // flagged (the case for every bundle predating this column) means the first
  // one, so nothing had to be backfilled; more than one is impossible through
  // the editor, and the widget takes the first it finds either way.
  isDefault        Boolean             @default(false)
  shopifyVariantId String?
  // SLOT_BUILDER only: this package's own product pool + slot count,
  // independent per package (e.g. "30ml" and "100ml" can offer different
  // pools/slot counts). Unused (defaults) for FIXED.
  poolSource       String              @default("PRODUCTS") // PRODUCTS | COLLECTIONS
  slotCount        Int                 @default(2)
  collectionIds    String              @default("[]") // JSON array of eligible collection GIDs
  // COLLECTIONS-sourced pools only: case-insensitive substring match against
  // each variant's own title (e.g. "50" only keeps "50ml" variants) — lets a
  // merchant narrow a whole collection's pool to one size/option without
  // hand-picking products. Empty = no filtering (every variant included).
  variantFilter    String              @default("")
  // Storefront pool-modal filter chips — JSON array of { label, tag }:
  // `label` is the button text customers see, `tag` the exact product tag it
  // matches (case-insensitive). Display-only; an "All" chip is added
  // automatically by the widget. Empty = no filter row shown.
  tagFilters       String              @default("[]")
  // SLOT_BUILDER only: this package's own customer-facing copy per
  // storefront locale — JSON { "fr": { label, badgeText, tagFilterLabels } }.
  // Lives on the package (not the bundle) so it rides the same upsert-by-id
  // path the rest of this row does: reordering or deleting a package can't
  // strand its translations on the wrong one. `tagFilterLabels` is positional
  // against `tagFilters` above — the `tag` a chip matches is never translated,
  // only the button text. Blank/missing falls back to the fields above.
  translations     String              @default("{}")
  items            BundlePackageItem[]
}

model BundlePackageItem {
  id              String        @id @default(cuid())
  packageId       String
  package         BundlePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  productId       String // Shopify product GID
  variantId       String? // Shopify variant GID (null = any variant)
  productTitle    String
  productImageUrl String?
  quantity        Int     @default(1)
  isGift          Boolean @default(false)
  position        Int     @default(0)
}

// Mix & match rules: which products are eligible and the discount tiers
model BundleRule {
  id            String @id @default(cuid())
  bundleId      String @unique
  bundle        Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  minItems      Int    @default(2)
  maxItems      Int?
  // JSON: [{ "quantity": 3, "discount": 10 }, { "quantity": 5, "discount": 15 }]
  discountTiers String @default("[]")
  // JSON array of eligible collection GIDs
  collectionIds String @default("[]")
}

// Shop-wide settings, one row per installed shop. Kept separate from Bundle
// so a setting isn't duplicated across every bundle a merchant owns.
model ShopSettings {
  shop      String   @id
  // Merchant-authored CSS appended to the storefront widget's own stylesheet,
  // for tweaks the app's own settings don't cover. Stored sanitized (see
  // sanitizeCustomCss) and mirrored into the magyx_bundle.custom_css shop
  // metafield, which is what the theme block actually reads — the storefront
  // never queries this table.
  customCss String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
